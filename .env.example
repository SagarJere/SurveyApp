# Copy to .env and adjust. Never commit .env.
# Backend reads this file from the repo root; the frontend (Vite) reads VITE_* values from it too.

# --- App ----------------------------------------------------------------
# development | test | production
APP_ENV=development
# dev = EmployeeId-only login (refused in production) | sso
AUTH_MODE=dev
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Auth ---------------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=480

# --- Database (docker compose) -----------------------------------------
POSTGRES_USER=surveyapp
POSTGRES_PASSWORD=surveyapp
POSTGRES_DB=surveyapp
# Host port for the dev database. 5433 avoids clashing with a locally installed Postgres.
POSTGRES_PORT=5433

DATABASE_URL=postgresql+asyncpg://surveyapp:surveyapp@localhost:5433/surveyapp
# Used by pytest. Created automatically by docker/postgres/init on first start.
TEST_DATABASE_URL=postgresql+asyncpg://surveyapp:surveyapp@localhost:5433/surveyapp_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Files --------------------------------------------------------------
# Theme images and exports. Relative paths are not allowed in production; use an absolute path.
FILE_STORAGE_PATH=./data/files

# --- HTTP ---------------------------------------------------------------
# Port the API listens on in development. The Vite dev server proxies /api here.
BACKEND_PORT=8001
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- Frontend (Vite) ----------------------------------------------------
# Base URL for API calls from the browser. Keep /api in development (uses the Vite proxy).
VITE_API_BASE_URL=/api
VITE_APP_NAME="Pulse"
